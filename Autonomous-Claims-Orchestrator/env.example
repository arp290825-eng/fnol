# OpenAI API Configuration (required for claim processing)
OPENAI_API_KEY=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

# Model: gpt-4o recommended for Vision (image analysis); gpt-4-1106-preview for text only
OPENAI_MODEL=gpt-4o
OPENAI_TEMPERATURE=0.1

# Demo Configuration
DEMO_MODE=true
ENABLE_REAL_AI=false

# IMAP Configuration (FNOL email ingestion - Gmail/Outlook)
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
SENDER_EMAIL=your_email@gmail.com
EMAIL_PASSWORD=your_app_password
# SENDER_EMAIL + EMAIL_PASSWORD also used for outbound email (acknowledgment, acceptance, denial)

# FNOL classifier: only ingest FNOL-related emails (set to false to ingest all)
# LLM assesses content when OPENAI_API_KEY is set; otherwise all emails are ingested
FNOL_FILTER_ENABLED=true

# Sync read emails: set to true to include already-read emails (default: true)
IMAP_SYNC_INCLUDE_READ=true

# Max emails per sync when including read (default: 100)
IMAP_SYNC_MAX_EMAILS=100

# Mailbox: INBOX (default). For read emails, Gmail uses "[Gmail]/All Mail" automatically.
# Set explicitly if needed: IMAP_MAILBOX="[Gmail]/All Mail"
# Enable All Mail in Gmail: Settings > Labels > All Mail > Show in IMAP

# SSL Verification: set to false to disable certificate verification (default: false)
# Set to true for strict SSL certificate verification
IMAP_SSL_VERIFY=false

# Deployment Configuration (optional - defaults to relative paths)
# Set these for deployment-ready configuration without local path dependencies
# PROJECT_ROOT=/path/to/project/root
# DATA_DIR=/path/to/data/directory
# INGESTED_DIR=/path/to/ingested/attachments
# PROCESSED_CLAIMS_DIR=/path/to/processed/claims
# ENV_FILE=/path/to/.env
# LOCAL_DATA_DIR=/path/to/database/local_data
# POLICY_GROUNDING_MAPPING_FILE=/path/to/policy_grounding_mapping.json
# FAQ_CSV_FILE=/path/to/FAQ.csv

# FastAPI Server Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=false
# CORS_ORIGINS=http://localhost:3000,http://localhost:3001
# For production, set specific origins: CORS_ORIGINS=https://yourdomain.com

# Frontend API Configuration
# IMPORTANT: Create frontend/.env.local file with this variable
# Note: Use localhost (not 0.0.0.0) as browsers cannot access 0.0.0.0
# The server binds to 0.0.0.0:8020 to accept connections from any interface
# But the frontend must use localhost:8020 to connect from the browser
# For local development: NEXT_PUBLIC_API_URL=http://localhost:8020
# For production: NEXT_PUBLIC_API_URL=https://api.yourdomain.com
#
# To configure: Create frontend/.env.local and add:
# NEXT_PUBLIC_API_URL=http://localhost:8020